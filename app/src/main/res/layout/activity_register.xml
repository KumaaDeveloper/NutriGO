<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/registerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <Space
        android:layout_width="match_parent"
        android:layout_height="42dp" />

    <ImageButton
        android:id="@id/btnBackRegister"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_back_box"
        android:contentDescription="@string/kembali"
        android:padding="5dp"
        android:src="@drawable/ic_back" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-32dp"
        android:gravity="center"
        android:text="@string/daftar"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:text="@string/masukkan_nama"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@id/etNamaRegister"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:autofillHints="name"
        android:background="@drawable/bg_input"
        android:hint="@string/nama"
        android:inputType="textPersonName"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="#000000"
        android:textColorHint="#888888"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/masukkan_email"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@id/etEmailRegister"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:autofillHints="emailAddress"
        android:background="@drawable/bg_input"
        android:hint="@string/email"
        android:inputType="textEmailAddress"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="#000000"
        android:textColorHint="#888888"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/masukkan_no_hp"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kode_negara"
            android:textColor="#000000"
            android:textSize="11sp" />

        <EditText
            android:id="@id/etPhoneRegister"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:autofillHints="phone"
            android:background="#00000000"
            android:hint="@string/hint_no_hp"
            android:inputType="phone"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="18dp"
            android:contentDescription="@string/bendera_indonesia"
            android:src="@drawable/ic_flag_indonesia" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/masukkan_alamat"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@id/etAlamatRegister"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:hint="@string/alamat"
        android:inputType="textPostalAddress"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="#000000"
        android:textColorHint="#888888"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/masukkan_password"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <EditText
            android:id="@id/etPasswordRegister"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:autofillHints="password"
            android:background="#00000000"
            android:hint="@string/hint_password"
            android:inputType="textPassword"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:textSize="11sp" />

        <ImageButton
            android:id="@id/btnEyeRegister"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="#00000000"
            android:contentDescription="@string/tampilkan_password"
            android:padding="7dp"
            android:src="@drawable/ic_eye_close" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/konfirmasi_password"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <EditText
            android:id="@id/etConfirmRegister"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:autofillHints="password"
            android:background="#00000000"
            android:hint="@string/hint_password"
            android:inputType="textPassword"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:textSize="11sp" />

        <ImageButton
            android:id="@id/btnEyeConfirmRegister"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="#00000000"
            android:contentDescription="@string/tampilkan_password"
            android:padding="7dp"
            android:src="@drawable/ic_eye_close" />

    </LinearLayout>

    <Button
        android:id="@id/btnDaftar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_button"
        android:text="@string/daftar"
        android:textAllCaps="false"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>