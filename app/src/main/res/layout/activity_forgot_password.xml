<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/forgotRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <Space
        android:layout_width="match_parent"
        android:layout_height="42dp" />

    <ImageButton
        android:id="@+id/btnBackForgot"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_back_box"
        android:contentDescription="@string/kembali"
        android:padding="5dp"
        android:src="@drawable/ic_back" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-32dp"
        android:gravity="center"
        android:text="@string/lupa_sandi"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:text="@string/verifikasi_melalui"
        android:textColor="#000000"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rgVerifikasi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#000000"
            android:checked="true"
            android:text="@string/email"
            android:textColor="#000000"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbNomorHp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:buttonTint="#000000"
            android:text="@string/nomor_hp"
            android:textColor="#000000"
            android:textSize="13sp" />

    </RadioGroup>

    <TextView
        android:id="@+id/tvLabelEmailForgot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="@string/masukkan_email"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etEmailForgot"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:autofillHints="emailAddress"
        android:background="@drawable/bg_input"
        android:hint="@string/email"
        android:inputType="textEmailAddress"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="#000000"
        android:textColorHint="#888888"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/masukkan_kode_verifikasi"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etKodeVerifikasi"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:autofillHints="oneTimeCode"
        android:background="@drawable/bg_input"
        android:hint="@string/hint_kode_verifikasi"
        android:inputType="number"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="#000000"
        android:textColorHint="#888888"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/masukkan_password_baru"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <EditText
            android:id="@+id/etPasswordBaru"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:autofillHints="newPassword"
            android:background="#00000000"
            android:hint="@string/hint_password"
            android:inputType="textPassword"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btnEyePasswordBaru"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="#00000000"
            android:contentDescription="@string/tampilkan_password"
            android:padding="7dp"
            android:src="@drawable/ic_eye" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/konfirmasi_password"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <EditText
            android:id="@+id/etConfirmForgot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:autofillHints="newPassword"
            android:background="#00000000"
            android:hint="@string/hint_password"
            android:inputType="textPassword"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btnEyeConfirmForgot"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="#00000000"
            android:contentDescription="@string/tampilkan_password"
            android:padding="7dp"
            android:src="@drawable/ic_eye" />

    </LinearLayout>

    <Button
        android:id="@+id/btnSelesai"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_button"
        android:text="@string/selesai"
        android:textAllCaps="false"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>