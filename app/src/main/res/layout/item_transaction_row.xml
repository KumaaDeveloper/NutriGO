<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/boxTransactionRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/imgTransResto"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:contentDescription="resto"
        android:scaleType="centerCrop"
        android:src="@drawable/img_placeholder_food" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/tvTransTanggal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvTransNamaResto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="8"
            android:singleLine="false"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTransTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTransStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#4CAF50"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <Button
        android:id="@+id/btnTransDetail"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/bg_button"
        android:minWidth="64dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="Detail"
        android:textAllCaps="false"
        android:textColor="#000000"
        android:textSize="12sp" />

</LinearLayout>