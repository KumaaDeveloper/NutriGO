<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_top_wave"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">
        <ImageButton
            android:id="@+id/btnBackTransaction"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_back_box"
            android:src="@drawable/ic_back"
            android:padding="6dp"
            android:contentDescription="Kembali"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Transaksi"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"/>
        <!-- spacer to balance back button -->
        <View android:layout_width="36dp" android:layout_height="36dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llTransaksiContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"/>
    </ScrollView>

</LinearLayout>
