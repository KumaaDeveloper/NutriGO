<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutEmptyTransaction"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="70dp"
    android:background="@drawable/bg_empty_transaction_box"
    android:elevation="4dp"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="32dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp">

    <ImageView
        android:id="@+id/imgEmptyTransaction"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:contentDescription="Belum ada transaksi"
        android:src="@drawable/ic_nav_transaction" />

    <TextView
        android:id="@+id/tvEmptyTransactionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Belum Ada Transaksi"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEmptyTransactionDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="Kamu belum melakukan transaksi apa pun. Yuk mulai pilih makanan favoritmu!"
        android:textColor="#6B6B6B"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnMulaiBelanjaTransaction"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_empty_transaction_button"
        android:minWidth="150dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:text="Mulai Belanja"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>