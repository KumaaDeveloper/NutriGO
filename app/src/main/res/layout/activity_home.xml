<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAFBFF"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="270dp">

                <com.example.pedulimakanan.HeaderCircleView
                    android:layout_width="match_parent"
                    android:layout_height="270dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingTop="52dp"
                    android:paddingEnd="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="Mau Makan Apa&#10;Kamu Hari Ini?"
                        android:textColor="#071015"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/bg_search"
                        android:elevation="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_search" />

                        <EditText
                            android:id="@+id/etSearchFood"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="Cari Makanan"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textColor="#111111"
                            android:textColorHint="#6F6F6F"
                            android:textSize="15sp" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

            <!-- BALANCE CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginStart="34dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="34dp"
                android:background="@drawable/bg_balance_card"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_circle_yellow"
                    android:gravity="center"
                    android:text="$"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Rp. 10.000"
                    android:textColor="#050505"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_plus_circle" />

                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:src="@drawable/ic_pay" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Pay"
                        android:textColor="#000000"
                        android:textSize="8sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:src="@drawable/ic_history" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="History"
                        android:textColor="#000000"
                        android:textSize="8sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- TITLE POPULER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="34dp"
                android:text="Makanan Sehat Populer"
                android:textColor="#071015"
                android:textSize="20sp" />

            <!-- CARD POPULER -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="32dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="4dp">

                    <!-- CARD 1 -->
                    <LinearLayout
                        android:layout_width="160dp"
                        android:layout_height="154dp"
                        android:background="@drawable/bg_food_card"
                        android:elevation="1dp"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="108dp"
                            android:background="@drawable/bg_food_green">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|start"
                                android:layout_marginStart="12dp"
                                android:layout_marginTop="10dp"
                                android:text="SALADSTOP!"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:text="MINI BOWL&#10;68K&#10;+&#10;40% OFF"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="end|bottom"
                                android:layout_marginEnd="10dp"
                                android:layout_marginBottom="10dp"
                                android:background="@drawable/bg_food_circle"
                                android:gravity="center"
                                android:text="🥗"
                                android:textSize="22sp" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="Saladstop"
                            android:textColor="#000000"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <!-- CARD 2 -->
                    <LinearLayout
                        android:layout_width="160dp"
                        android:layout_height="154dp"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/bg_food_card"
                        android:elevation="1dp"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="108dp"
                            android:background="@drawable/bg_food_orange">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|start"
                                android:layout_marginStart="14dp"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_label_new"
                                android:paddingStart="8dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="2dp"
                                android:text="NEW"
                                android:textColor="#FFFFFF"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:text="IT'S HOT,&#10;FRESH&#10;&amp; SUPER&#10;TASTY"
                                android:textColor="#08715F"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="end|bottom"
                                android:layout_marginEnd="10dp"
                                android:layout_marginBottom="10dp"
                                android:background="@drawable/bg_food_circle"
                                android:gravity="center"
                                android:text="🥙"
                                android:textSize="22sp" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="Burgreen"
                            android:textColor="#000000"
                            android:textSize="16sp" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

            <!-- TITLE MURAH -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="28dp"
                android:text="Makanan Sehat Murah"
                android:textColor="#071015"
                android:textSize="20sp" />

            <!-- CARD MURAH -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="32dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="20dp">

                    <!-- CARD 3 -->
                    <LinearLayout
                        android:layout_width="160dp"
                        android:layout_height="154dp"
                        android:background="@drawable/bg_food_card"
                        android:elevation="1dp"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="108dp"
                            android:background="@drawable/bg_food_green">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:text="HEALTHY&#10;FOOD&#10;PROMO"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="end|bottom"
                                android:layout_marginEnd="10dp"
                                android:layout_marginBottom="10dp"
                                android:background="@drawable/bg_food_circle"
                                android:gravity="center"
                                android:text="🍱"
                                android:textSize="22sp" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="Healthy Bowl"
                            android:textColor="#000000"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <!-- CARD 4 -->
                    <LinearLayout
                        android:layout_width="160dp"
                        android:layout_height="154dp"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/bg_food_card"
                        android:elevation="1dp"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="108dp"
                            android:background="@drawable/bg_food_orange">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:text="FRESH&#10;SALAD&#10;MURAH"
                                android:textColor="#08715F"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="end|bottom"
                                android:layout_marginEnd="10dp"
                                android:layout_marginBottom="10dp"
                                android:background="@drawable/bg_food_circle"
                                android:gravity="center"
                                android:text="🥬"
                                android:textSize="22sp" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="Fresh Salad"
                            android:textColor="#000000"
                            android:textSize="16sp" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

        </LinearLayout>

    </ScrollView>

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="3dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageButton
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_active"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/navFavorite"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_favorite" />

        <ImageButton
            android:id="@+id/navCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_cart" />

        <ImageButton
            android:id="@+id/navOrder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_order" />

        <ImageButton
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_profile" />

    </LinearLayout>

</FrameLayout>