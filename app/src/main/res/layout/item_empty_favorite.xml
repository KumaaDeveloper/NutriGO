<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutEmptyFavorite"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="70dp"
    android:background="@drawable/bg_empty_favorite_box"
    android:elevation="4dp"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="32dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp">

    <ImageView
        android:id="@+id/imgEmptyFavorite"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:contentDescription="Belum ada favorit"
        android:src="@drawable/ic_favorite" />

    <TextView
        android:id="@+id/tvEmptyFavoriteTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Belum Ada Favorit"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEmptyFavoriteDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="Belum ada makanan atau restoran yang kamu favoritkan. Yuk cari makanan favoritmu!"
        android:textColor="#6B6B6B"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnCariMakanan"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_empty_favorite_button"
        android:minWidth="150dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:text="Cari Makanan"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>