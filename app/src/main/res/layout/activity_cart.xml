<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:id="@+id/llToolbarCart"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_top_wave"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:layout_alignParentTop="true">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_back_box"
            android:src="@drawable/ic_back"
            android:padding="6dp"
            android:contentDescription="Kembali"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Keranjang Belanja"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <View android:layout_width="36dp" android:layout_height="36dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llBottomCheckoutContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Pembayaran:"
                android:textColor="#555555"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvCartTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0"
                android:textColor="#FF4A4A"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvSaldoInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saldo Anda: Rp. 0"
            android:textColor="#246E9B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCheckoutCart"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Proses Checkout"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#4CAF50"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llToolbarCart"
        android:layout_above="@id/llBottomCheckoutContainer"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/llCartContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"/>
    </ScrollView>

</RelativeLayout>